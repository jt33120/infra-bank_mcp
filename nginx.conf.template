worker_processes 1;
events { worker_connections 256; }
http {
  # Journalise les requetes sur stdout (visibles dans les logs Railway) : sans ca,
  # nginx ecrit dans /var/log/nginx/access.log a l'interieur du conteneur et on ne
  # voit pas ce qu'un client MCP a reellement tente (ex : decouverte OAuth).
  access_log /dev/stdout;
  error_log /dev/stderr warn;

  server {
    listen 8080;

    # Ce serveur n'expose PAS de fournisseur OAuth : l'auth est un simple bearer
    # statique. Notion choisit tout seul sa methode de connexion d'apres ce que le
    # serveur annonce, donc le moindre 401 sur un chemin de decouverte se lit comme
    # "un serveur d'autorisation existe derriere cette auth" et l'enferme dans un
    # parcours OAuth + enregistrement dynamique de client (RFC 7591) qui ne peut
    # jamais aboutir. Notion sonde /.well-known/* (oauth-protected-resource,
    # oauth-authorization-server, openid-configuration, mcp.json) ET /oauth/*
    # (authorize, token, register), en GET comme en OPTIONS. Un 404 franc sur tout
    # cet espace dit "pas d'OAuth ici" et le renvoie vers l'auth par en-tete.
    location ~ ^/(\.well-known/|oauth/|register$|authorize$|token$) { return 404; }

    location / {
      # Un preflight CORS ne porte jamais d'en-tete Authorization : le soumettre au
      # test d'auth ci-dessous le ferait echouer en 401 et bloquerait tout client
      # navigateur avant meme la premiere requete MCP.
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Mcp-Session-Id, Mcp-Protocol-Version, Last-Event-Id" always;
        add_header Access-Control-Max-Age "86400" always;
        return 204;
      }

      # WWW-Authenticate est obligatoire sur un 401 (RFC 7235) et son contenu est le
      # signal qui departage les deux modes : "Bearer" seul = jeton statique a saisir,
      # alors qu'un parametre resource_metadata=... declencherait la decouverte OAuth.
      # Sans en-tete du tout, le client doit deviner — et Notion devine OAuth.
      if ($http_authorization != "Bearer ${MCP_AUTH_TOKEN}") {
        add_header WWW-Authenticate "Bearer" always;
        return 401;
      }

      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Expose-Headers "Mcp-Session-Id" always;

      proxy_pass http://127.0.0.1:8100;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
  }
}
